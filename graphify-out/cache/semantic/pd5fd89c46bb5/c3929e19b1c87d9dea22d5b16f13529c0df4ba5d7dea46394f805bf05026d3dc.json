{"nodes": [{"id": "docs_superpowers_specs_2026_07_10_auth_schema_design_auth_schema_design", "label": "Auth Schema Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-10-auth-schema-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema-only change for password login + DB-backed session tokens using native Bun/Postgres/JS features, explicitly avoiding new auth dependencies (bcrypt/JWT libs); register/login/logout endpoints are out of scope."}, {"id": "docs_superpowers_specs_2026_07_10_auth_schema_design_userstable_auth_columns", "label": "usersTable auth columns (password, role)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-10-auth-schema-design.md", "source_location": "## Perubahan usersTable", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "password stores a hash (Bun.password.hash/verify, native bcrypt in Bun runtime, no new dependency); role uses a Postgres enum so values are constrained at the DB level rather than only in Zod."}, {"id": "docs_superpowers_specs_2026_07_10_auth_schema_design_sessionstable", "label": "sessionsTable (DB-backed session tokens)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-10-auth-schema-design.md", "source_location": "## Tabel baru sessionsTable", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "token generated with crypto.randomUUID() (native Web Crypto) to avoid a JWT/session library; userId FK uses onDelete cascade so sessions are auto-removed when a user is deleted, avoiding manual cleanup in the service layer."}, {"id": "docs_superpowers_specs_2026_07_10_auth_schema_design_userroleenum", "label": "userRoleEnum (pg enum user_role: user, admin)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-10-auth-schema-design.md", "source_location": "## Perubahan usersTable", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_10_auth_schema_design_yagni_deferrals", "label": "Auth schema YAGNI deferrals (createdAt/userAgent/ipAddress, emailVerified, auth endpoints)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-10-auth-schema-design.md", "source_location": "## Yang sengaja belum dibikin (YAGNI)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately deferred until real need: session audit columns (createdAt/userAgent/ipAddress) until a 'manage login devices' feature exists, emailVerified until an email verification flow exists, and register/login/logout endpoints which are outside this schema change's scope. Written explicitly (consistent with docs/error-handling.md) so deferrals are tracked, not silently forgotten."}], "edges": [{"source": "docs_superpowers_specs_2026_07_10_auth_schema_design_sessionstable", "target": "docs_superpowers_specs_2026_07_10_auth_schema_design_userstable_auth_columns", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-10-auth-schema-design.md", "source_location": "## Tabel baru sessionsTable (userId FK -> usersTable.id)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_10_auth_schema_design_userstable_auth_columns", "target": "docs_superpowers_specs_2026_07_10_auth_schema_design_userroleenum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-10-auth-schema-design.md", "source_location": "## Perubahan usersTable (role column)", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_10_auth_schema_design_auth_schema_design", "target": "docs_superpowers_specs_2026_07_10_auth_schema_design_userstable_auth_columns", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou